# codePost — Unified reverse proxy configuration
# Routes:
#   /api/*, /admin/*, /ws/*, /health-check → API (Django)
#   Everything else → UI (React SPA)

map $http_upgrade $connection_upgrade {
    default upgrade;
    '' close;
}

# ─── HTTPS Server ────────────────────────────────────────────────────
server {
    listen 443 ssl;
    http2 on;
    server_name ${NGINX_SERVER_NAME};

    ssl_certificate /etc/ssl/certs/fullchain.pem;
    ssl_certificate_key /etc/ssl/certs/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5;
    ssl_prefer_server_ciphers on;

    client_max_body_size 6M;

    # Security headers
    add_header X-Content-Type-Options nosniff always;
    add_header X-XSS-Protection "1; mode=block" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header Referrer-Policy "no-referrer-when-downgrade" always;

    error_log /var/log/nginx/error.log warn;

    # Docker DNS: re-resolve container names at request time (paired with the
    # $upstream_* variables in proxy_pass) so a recreated api/ui container never
    # leaves nginx pointing at a stale IP, and nginx starts even if one is not up yet.
    resolver 127.0.0.11 valid=10s ipv6=off;
    set $upstream_api codepost-api;
    set $upstream_ui codepost-ui;

    # ── WebSocket (Django Channels) ────
    location /ws/ {
        proxy_pass http://$upstream_api:8000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 3600;
    }

    # ── API routes → Django ────
    location /api/ {
        proxy_pass http://$upstream_api:8000;
        error_page 502 503 504 @api_unavailable;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /admin/ {
        proxy_pass http://$upstream_api:8000;
        error_page 502 503 504 @api_unavailable;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /health-check {
        proxy_pass http://$upstream_api:8000;
        error_page 502 503 504 @api_unavailable;
        proxy_set_header Host $host;
    }

    location /static/ {
        proxy_pass http://$upstream_api:8000;
        proxy_set_header Host $host;
    }

    # When the API container is down or restarting, answer JSON (+ Retry-After)
    # instead of nginx's HTML 502 so the SPA can show one "API unavailable" banner
    # and retry. Same origin here, so no CORS headers are needed.
    location @api_unavailable {
        default_type application/json;
        add_header Retry-After 10 always;
        return 503 '{"detail": "codePost API is temporarily unavailable. Please retry shortly."}';
    }

    # ── Everything else → React UI ────
    location / {
        proxy_pass https://$upstream_ui:8443;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}

# ─── HTTP → HTTPS Redirect + ACME challenge ─────────────────────────
server {
    listen 80;
    server_name ${NGINX_SERVER_NAME};

    # Let's Encrypt ACME challenge
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    # Health check (for proxy container itself)
    location /health {
        return 200 "healthy\n";
        add_header Content-Type text/plain;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}
