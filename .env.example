# ──────────────────────────────────────────────────────────────────────
# codePost — Environment Configuration
# ──────────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your values.
# Or run: python ../codePost-api/scripts/create_env.py --output .env
#
# All values marked CHANGE_ME must be set before first run.
# ──────────────────────────────────────────────────────────────────────

# ─── General ─────────────────────────────────────────────────────────
# Set to TRUE only for debugging — never in production.
DEBUG=FALSE

# ─── Security & Encryption ──────────────────────────────────────────
# Used for Django session signing, CSRF tokens, etc. Must be unique per deployment.
SECRET_KEY=CHANGE_ME

# Used to encrypt sensitive database fields. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
FIELD_ENCRYPTION_KEY=CHANGE_ME

# ─── Database (MariaDB) ────────────────────────────────────────────
# In the unified compose, the database hostname is always "database".
DB_HOSTNAME=database
DB_NAME=codepost
DB_USERNAME=codepost_user
DB_PASSWORD=CHANGE_ME
ROOT_DATABASE_PASSWORD=CHANGE_ME

# InnoDB buffer pool size — set to ~70% of available RAM on the DB host.
INNODB_BUFFER_POOL_SIZE=1G

# ─── API Admin User ────────────────────────────────────────────────
# Created on first startup if it doesn't already exist.
API_USER=admin
API_PASSWORD=CHANGE_ME

# ─── URLs ───────────────────────────────────────────────────────────
# These must match your actual domain names. Used for CORS, CSRF, and email links.
API_URL=https://codepost.youruniversity.edu
CLIENT_URL=https://codepost.youruniversity.edu

# ─── Nginx ──────────────────────────────────────────────────────────
# Space-separated list of domains the proxy should respond to.
NGINX_SERVER_NAME=localhost codepost.youruniversity.edu

# ─── Email ──────────────────────────────────────────────────────────
# SMTP server for sending system emails (password resets, notifications, etc.)
EMAIL_HOST=smtp.youruniversity.edu
DEFAULT_EMAIL_FROM=no-reply@youruniversity.edu

# ─── Autograder ────────────────────────────────────────────────────
# Number of concurrent autograder executions per worker.
CELERY_CONCURRENCY=4

# Host path for persistent assignment datasets.
HOST_DATASET_ROOT=/mnt/datasets

# Whether to automatically run submissions against test cases on upload.
AUTOGRADER_AUTO_EXECUTE=true

# ─── Worker Shell Relay ────────────────────────────────────────────
# Shared secret for the WebSocket relay between API and autograder workers.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
WORKER_SHELL_SHARED_SECRET=CHANGE_ME
WORKER_SHELL_WORKER_ID=worker-1

# ─── Flower (optional monitoring) ─────────────────────────────────
# Port for the Flower Celery monitoring UI. Only exposed when using --profile monitoring.
FLOWER_PORT=5555

# ─── Google Analytics (optional) ───────────────────────────────────
# Leave blank to disable tracking.
REACT_APP_GA_ID=
REACT_APP_OPTIMIZE_ID=
